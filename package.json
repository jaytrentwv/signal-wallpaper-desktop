{
  "name": "signal-wallpaper-desktop",
  "version": "1.0.0",
  "description": "SIGNAL/WALLPAPER desktop live wallpaper encoder for Windows and macOS.",
  "main": "main.js",
  "author": "pwnhacker.com",
  "homepage": "https://pwnhacker.com/majorjoker/live-wallpaper-generator.html",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.pwnhacker.signalwallpaper",
    "productName": "SIGNAL Wallpaper",
    "artifactName": "SIGNAL-Wallpaper-${version}-${os}-${arch}.${ext}",
    "directories": {"output": "dist", "buildResources": "build"},
    "files": ["main.js", "preload.js", "app/**/*", "package.json"],
    "asar": true,
    "asarUnpack": ["app/ffmpeg/*.wasm"],
    "win": {"target": [{"target": "nsis", "arch": ["x64", "arm64"]}], "icon": "build/icon.ico"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "SIGNAL Wallpaper"},
    "mac": {"target": [{"target": "dmg", "arch": ["x64", "arm64"]}, {"target": "zip", "arch": ["x64", "arm64"]}], "category": "public.app-category.graphics-design", "icon": "build/icon.png", "hardenedRuntime": true, "gatekeeperAssess": false},
    "dmg": {"title": "SIGNAL Wallpaper ${version}"}
  }
}
